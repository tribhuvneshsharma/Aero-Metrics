# Database Settings (PostgreSQL)
POSTGRES_USER=apix_user
POSTGRES_PASSWORD=apix_password
POSTGRES_DB=apix_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://apix_user:apix_password@localhost:5432/apix_db

# Object Storage (MinIO / S3 for Raw Quote Evidence)
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_secret_key
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET_NAME=apix-raw-quotes

# API Service
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=True
API_CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Dashboard Service
NEXT_PUBLIC_API_URL=http://localhost:8000

# Pipeline & Index Governance
DATA_MODE=replay_fixture # options: live_permitted, replay_fixture, synthetic_demo
METHODOLOGY_VERSION=0.1.0
WEIGHT_VERSION=0.1.0
PIPELINE_VERSION=0.1.0
BASE_PERIOD=2026-01-01
COLLECTION_TIMEZONE=Asia/Kolkata

